{
  "name": "343labs-music-studio",
  "productName": "343 Labs Music Studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron-main.cjs",
  "description": "AI-powered music generation with native DAW integration",
  "author": "343 Labs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "inject-env": "node inject-env.js",
    "inject-env-html": "node inject-env-html.cjs",
    "build:reset": "npm run inject-env-html && npm run build",
    "build:secure": "vite build",
    "electron": "electron .",
    "electron:dev": "NODE_ENV=development electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "test:electron": "node test-electron-setup.cjs"
  },
  "build": {
    "appId": "com.343labs.musicstudio",
    "productName": "343 Labs Music Studio",
    "directories": {
      "output": "electron-dist"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "electron-preload.cjs",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "public/vite.svg",
      "target": ["dmg", "zip"]
    },
    "win": {
      "icon": "public/vite.svg",
      "target": ["nsis", "portable"]
    },
    "linux": {
      "icon": "public/vite.svg",
      "target": ["AppImage", "deb"]
    }
  },
  "devDependencies": {
    "electron": "^39.1.2",
    "electron-builder": "^26.0.12",
    "supabase": "^2.51.0",
    "vite": "^5.4.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.56.0",
    "lucide": "^0.547.0"
  }
}
